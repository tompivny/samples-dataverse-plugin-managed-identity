<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Output of `dotnet pack` for the Build project. In a real setup this is a private feed such as Azure Artifacts. -->
    <add key="local-build-tools" value="artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-build-tools">
      <package pattern="Samples.Dataverse.ManagedIdentity.Build" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
